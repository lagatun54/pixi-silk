---
import { FAQ } from '@/content/faq.mjs';
import Base from '@/layouts/Base.astro';
import { breadcrumbLd, faqLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

const description = `Answers about anti-aliasing and smooth graphics in PixiJS v8: MSAA vs SDF, jagged or blurry edges, squircles, banding-free gradients, glows, retina.`;
const html = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Base title={`PixiJS anti-aliasing and smooth graphics FAQ | ${SITE.name}`} description={description} path="/faq/" jsonLd={[faqLd(FAQ), breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'FAQ', url: '/faq/' }])]}>
    <div class="container-page max-w-3xl py-14" data-pagefind-body data-pagefind-filter="section:FAQ">
        <h1 class="text-4xl font-semibold tracking-tight">Frequently asked questions</h1>
        <p class="mt-3 text-muted-foreground">{description}</p>
        <div class="prose-docs mt-10">
            {FAQ.map((item) => (
                <section id={slug(item.q)} class="border-b py-2">
                    <h2 class="!mt-6 !text-lg">{item.q}<a class="heading-anchor" href={`#${slug(item.q)}`} aria-label={`Permalink to "${item.q}"`} data-pagefind-ignore>#</a></h2>
                    <p set:html={html(item.a)} />
                </section>
            ))}
        </div>
    </div>
</Base>
