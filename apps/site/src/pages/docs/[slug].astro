---
import { getCollection, render } from 'astro:content';
import Callout from '@/components/Callout.astro';
import Demo from '@/components/Demo.astro';
import Glossary from '@/components/Glossary.astro';
import Docs from '@/layouts/Docs.astro';
import { apiPages } from '@/lib/api';

export async function getStaticPaths() {
    const docs = await getCollection('docs');

    return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, seoTitle, description, eyebrow, api, keywords, updated } = entry.data;
const reference = apiPages();
const refs = api.map((name) => ({ name, href: reference.find((p) => p.title === name)?.href ?? '/api/' }));
---

<Docs title={title} seoTitle={seoTitle} description={description} eyebrow={eyebrow} headings={headings} keywords={keywords} updated={updated} markdown={`/docs/${entry.id}.md`}>
    <Content components={{ Demo, Callout, Glossary }} />
    {refs.length > 0 && (
        <p class="mt-10 text-sm !text-muted-foreground">
            API reference: {refs.map((r, i) => (<>{i > 0 && ', '}<a href={r.href}><code>{r.name}</code></a></>))}
        </p>
    )}
</Docs>
