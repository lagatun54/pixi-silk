---
import { DOCS_NAV } from '@/content/nav.mjs';
import Base from '@/layouts/Base.astro';
import { docsInOrder } from '@/lib/docs';
import { breadcrumbLd } from '@/lib/seo';
import { SITE } from '@/lib/site';

const docs = await docsInOrder();
const description = `Guides for ${SITE.name}: install it, draw smooth shapes, paint gradients and glows, build charts and UI, and learn how analytic anti-aliasing works.`;
---

<Base title={`Docs: smooth, anti-aliased graphics for PixiJS v8 | ${SITE.name}`} description={description} path="/docs/" jsonLd={[breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'Docs', url: '/docs/' }])]}>
    <div class="container-page py-14" data-pagefind-body data-pagefind-filter="section:Docs">
        <h1 class="text-4xl font-semibold tracking-tight">Documentation</h1>
        <p class="mt-3 max-w-2xl text-muted-foreground">{description} Every guide has live demos with their source.</p>
        {DOCS_NAV.map((section) => (
            <section class="mt-12" id={section.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
                <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{section.title}</h2>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    {docs.filter((d) => d.section === section.title).map((d) => (
                        <a href={d.href} class="rounded-xl border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-foreground/30">
                            <div class="font-semibold">{d.title}</div>
                            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{d.description}</p>
                        </a>
                    ))}
                </div>
            </section>
        ))}
        <section class="mt-12">
            <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">Reference</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <a href="/api/" class="rounded-xl border bg-card p-5 hover:border-foreground/30"><div class="font-semibold">API reference</div><p class="mt-1.5 text-sm text-muted-foreground">Every export, generated from the source's JSDoc.</p></a>
                <a href="/faq/" class="rounded-xl border bg-card p-5 hover:border-foreground/30"><div class="font-semibold">FAQ</div><p class="mt-1.5 text-sm text-muted-foreground">Short answers to the usual questions.</p></a>
                <a href="/llms-full.txt" class="rounded-xl border bg-card p-5 hover:border-foreground/30"><div class="font-semibold">llms-full.txt</div><p class="mt-1.5 text-sm text-muted-foreground">All docs and demo sources as one plain-text file for AI assistants.</p></a>
            </div>
        </section>
    </div>
</Base>
