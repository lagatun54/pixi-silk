---
interface Props {
    nav: { title: string; items: { label: string; href: string }[] }[];
    pathname: string;
}
const { nav, pathname } = Astro.props;
const isActive = (href: string) => pathname === href || pathname === href.replace(/\/$/, '');
const current = nav.flatMap((s) => s.items).find((i) => isActive(i.href));
---

<aside class="md:sticky md:top-20 md:max-h-[calc(100vh-6rem)] md:self-start md:overflow-y-auto md:pb-8">
    <details class="group md:hidden" data-pagefind-ignore>
        <summary class="cursor-pointer rounded-md border px-3 py-2 text-sm">{current?.label ?? 'Menu'}</summary>
        <div class="mt-2"><slot name="mobile" /></div>
    </details>
    <nav aria-label="Docs" class="hidden text-sm md:block" data-pagefind-ignore>
        {nav.map((section) => (
            <div class="mb-6">
                <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">{section.title}</div>
                <ul class="space-y-0.5 border-l">
                    {section.items.map((item) => (
                        <li>
                            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={[
                                '-ml-px block border-l py-1 pl-3 transition-colors',
                                isActive(item.href) ? 'border-silk font-medium text-foreground' : 'border-transparent text-muted-foreground hover:border-foreground/30 hover:text-foreground',
                            ]}>
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </nav>
</aside>
