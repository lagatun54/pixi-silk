---
import { Moon, Sun } from 'lucide-react';
---

<button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
    <Moon className="h-4 w-4 dark:hidden" />
    <Sun className="hidden h-4 w-4 dark:block" />
</button>
<script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');

        localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
</script>
