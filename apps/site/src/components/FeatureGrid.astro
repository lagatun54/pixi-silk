---
import { Aperture, Blend, Gauge, Layers, MousePointerClick, Ruler, Sparkles, SquareDashed } from 'lucide-react';

const features = [
    { icon: Aperture, title: 'Exact anti-aliasing', body: 'Each pixel gets its coverage from the exact distance to the shape. Smooth at any zoom, rotation and DPR, in filters and render textures too.' },
    { icon: Layers, title: 'One draw call', body: 'Each SilkGraphics is one instanced draw call. Rebuilding 50,000 primitives takes about 12 ms of CPU per frame.' },
    { icon: Ruler, title: 'Squircles and more shapes', body: 'Smooth squircle corners, per-corner radii, arcs, donut sectors, hearts, stars, rounded triangles and chart areas.' },
    { icon: Blend, title: 'OKLab gradients', body: 'Linear, radial, conic and along-the-path gradients. Mixed in OKLab, stored as half floats and dithered, so they do not band.' },
    { icon: Sparkles, title: 'Glows and soft shadows', body: 'Blur any fill or stroke. Neon glows, drop shadows and motion blur cost no filter and no extra pass.' },
    { icon: SquareDashed, title: 'Dashes, dots, tapers', body: 'Dashes and dots with caps, drawn in the shader. Closed outlines have no seam. Strokes can taper along the path.' },
    { icon: Gauge, title: 'DPR-exact canvas', body: 'createSilkApp maps canvas pixels 1:1 to device pixels, even at 1.5x or 2.625x, and follows DPR changes.' },
    { icon: MousePointerClick, title: 'Real hit testing', body: 'Pointer events test the real shape. Rings are hollow and a line only reacts on its stroke.' },
];
---

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {features.map((f) => (
        <div class="rounded-xl border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-foreground/30">
            <f.icon className="h-5 w-5 text-silk" />
            <div class="mt-3 font-semibold">{f.title}</div>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{f.body}</p>
        </div>
    ))}
</div>
