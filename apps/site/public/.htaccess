# For Apache-based hosting (e.g. Timeweb virtual hosting). The Docker image uses deploy/nginx.conf instead.
Options -Indexes
DirectorySlash On
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType text/markdown .md
AddType application/manifest+json .webmanifest

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/css application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(html)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "^llms(-full)?\.txt$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# hashed build assets never change
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/(_astro|fonts)/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
